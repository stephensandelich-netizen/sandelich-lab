---
import Layout from "../layouts/Layout.astro";

interface Item {
  title?: string;
  subtitle?: string;
  date?: string;
  description?: string;
  link?: string;
  badges?: string[];
  highlights?: string[];
  links?: Array<{ label?: string; href?: string; icon?: string }>;
}

interface Section {
  id: string;
  kicker?: string;
  title: string;
  items: (string | Item)[];
}

interface Props {
  kicker: string;
  pageTitle: string;
  pageDescription: string;
  schemaType?: string;
  sections: Section[];
}

const { kicker, pageTitle, pageDescription, schemaType = "CollectionPage", sections } = Astro.props;
---

<Layout title={pageTitle} description={pageDescription} schemaType={schemaType}>
  <div class="page-stack">
    <header class="page-header">
      <p class="page-kicker">{kicker}</p>
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-description">{pageDescription}</p>
    </header>

    <div class="space-y-7 sm:space-y-8">
      {sections.map((section) => (
        <section id={section.id} class="content-section scroll-mt-20 space-y-4">
          <header class="border-b border-gray-200 pb-3 dark:border-gray-700">
            {section.kicker && <p class="section-kicker">{section.kicker}</p>}
            <h2 class="section-heading">{section.title}</h2>
          </header>
          <div class="grid gap-3 md:grid-cols-2">
            {section.items.map((item) => {
              if (typeof item === "string") {
                return (
                  <article class="surface-card h-full">
                    <p class="body-copy">{item}</p>
                  </article>
                );
              }
              return (
                <article class="surface-card-hover h-full space-y-2">
                  <div class="flex items-start justify-between gap-3">
                    <div class="space-y-1">
                      {item.title && (
                        <h3 class="entry-title">
                          {item.link ? (
                            <a
                              href={item.link}
                              target="_blank"
                              rel="noreferrer"
                              class="inline text-inherit no-underline transition-colors hover:text-accent-700 focus-visible:text-accent-700 dark:hover:text-accent-300 dark:focus-visible:text-accent-300"
                            >
                              <span>{item.title}</span>
                              <span class="i-mdi:open-in-new ml-1 inline-block align-[0.05em] text-xs" aria-hidden="true"></span>
                            </a>
                          ) : (
                            item.title
                          )}
                        </h3>
                      )}
                      {item.subtitle && (
                        <p class="entry-supporting font-semibold text-accent-700 dark:text-accent-300">{item.subtitle}</p>
                      )}
                    </div>
                    {item.date && <p class="entry-meta shrink-0 tabular-nums">{item.date}</p>}
                  </div>
                  {item.description && <p class="entry-summary">{item.description}</p>}
                  {item.badges && item.badges.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {item.badges.map((badge) => (
                        <span class="meta-chip">{badge}</span>
                      ))}
                    </div>
                  )}
                  {item.highlights && item.highlights.length > 0 && (
                    <ul class="space-y-2 border-l-2 border-accent-200 pl-4 dark:border-accent-800">
                      {item.highlights.map((highlight) => (
                        <li class="body-copy">{highlight}</li>
                      ))}
                    </ul>
                  )}
                  {item.links && item.links.length > 0 && (
                    <div class="flex flex-wrap gap-2 pt-1">
                      {item.links.map(
                        (link) =>
                          link.href && (
                            <a href={link.href} target="_blank" rel="noreferrer" class="action-link min-h-11">
                              <span class={link.icon ?? "i-mdi:open-in-new"} aria-hidden="true"></span>
                              {link.label ?? "Read more"}
                            </a>
                          ),
                      )}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>
